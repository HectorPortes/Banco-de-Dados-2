CREATE TABLE clientes (
	id INT PRIMARY KEY,
	nome VARCHAR(50),
	cpf INT,
	cidade VARCHAR(150)
);

CREATE TABLE veiculos (
	id INT PRIMARY KEY,
	modelo VARCHAR(150),
	placa CHAR(7),
	diaria REAL
);

CREATE TABLE locacoes (
	id INT PRIMARY KEY,
	cli_id INT,
	vei_id INT,
	data_ret DATE,
	data_dev DATE,
	valor_total REAL,
	FOREIGN KEY (cli_id) REFERENCES clientes(id),
	FOREIGN KEY (vei_id) REFERENCES veiculos(id)
);

