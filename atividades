-- Tabela de cursos (tabela "direita" nos JOINs)
CREATE TABLE cursos (
id SERIAL PRIMARY KEY,
nome VARCHAR(50) NOT NULL,
carga_horaria INTEGER
);
-- Tabela de alunos (tabela "esquerda" nos JOINs)
CREATE TABLE alunos (
id SERIAL PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
idade INTEGER,
curso_id INTEGER REFERENCES cursos(id),
telefone VARCHAR(20),
salario NUMERIC(10,2) -- Para demonstrar SUM e AVG
);
-- Tabela de funcionários (para demonstrar funções de agregação)
CREATE TABLE funcionarios (
id SERIAL PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
departamento VARCHAR(50),
salario NUMERIC(10,2)
);
-- Tabela de professores (para UNION/INTERSECT/EXCEPT)
CREATE TABLE professores (
id SERIAL PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
disciplina VARCHAR(50)
);

