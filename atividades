-- 1 - todos os alunos que não tem telefone
select * from alunos
	Where telefone is null

-- 2 - todos os alunos que tem telefone
select * from alunos
	where telefone is not null

-- 3 - alunos que tenham mais de 21 anos e salario maior que 2500
select * from alunos
	where idade > 21 and salario > 2500

-- 4 - funcionário se departamento for TI e mostre o salário e nome
select salario, nome from funcionarios
	where departamento = 'TI'

-- 5 - professores que dão aula na disciplina de estrutura de dados ou programação
select * from professores
	where disciplina = 'Estrutura de Dados' or disciplina = 'Programação'

-- 6 - cursos com carga horária maior que 400
select * from cursos
	where carga_horaria > 400

-- 7 - todos os alunos com o nome do curso que estão fazendo
select a.nome as aluno, c.nome as curso
from alunos a
	inner join cursos c on a.curso_id = c.id

-- 8 - todos os cursos com a quantidade de alunos matriculados (incluindo cursos vazios)
select c.id as curso_id, c.nome as curso, count(a.nome) as qtde_alunos
	from alunos a
	left join cursos c on a.curso_id = c.id
	group by curso, c.id
	order by c.id

-- 9 - alunos que estão matriculados em cursos com carga horária acima de 350 horas
select a.nome as aluno, c.nome as curso, c.carga_horaria
	from alunos a
	inner join cursos c on a.curso_id = c.id
	where c.carga_horaria > 350

-- 10 - alunos com seus cursos, mas apenas dos cursos de Informática e Engenharia
select a.nome as aluno, c.nome as curso
	from alunos a
	inner join cursos c on a.curso_id = c.id
	where c.nome = 'Informática' or c.nome = 'Engenharia'

-- 11 - Conte quantos alunos tem em cada curso
select c.id as curso_id, c.nome as curso, count(a.nome) as qtde_alunos
	from alunos a
	inner join cursos c on a.curso_id = c.id
	group by curso, c.id
	order by c.id

-- 12 - Calcule a idade média dos alunos por curso
select c.id as curso_id, c.nome as curso, avg(a.idade) as idade_media
	from alunos a
	inner join cursos c on a.curso_id = c.id
	group by curso, c.id
	order by c.id

-- 13 - Mostre o salário total e a média salarial dos alunos agrupados por curso
select c.id as curso_id, c.nome as curso, sum(a.salario) as soma_salarial_total, avg(a.salario) as media_salarial
	from alunos a
	inner join cursos c on a.curso_id = c.id
	group by curso, c.id
	order by c.id

-- 14 - Conte quantos funcionários tem em cada departamento
select f.departamento, count(f.departamento)
	from funcionarios f
	group by f.departamento

-- 15 - Quais cursos têm mais de 2 alunos matriculados?
select c.nome as curso, count(a.nome) as qtde_alunos
	from alunos a
	inner join cursos c on a.curso_id = c.id
	group by curso
	having count(a.nome) > 2

-- 16 - Mostre os departamentos com salário médio acima de 4000
select f.departamento, f.salario
	from funcionarios f
	where f.salario > 4000

-- 17 - Encontre alunos que têm telefone E estão no curso de Informática
select a.nome as aluno, a.telefone, c.nome as curso
	from alunos a
	inner join cursos c on a.curso_id = c.id
	where a.telefone is not null and c.nome = 'Informática'

-- 18 - Mostre alunos do curso de Matemática OU Física
select a.nome as aluno, c.nome as curso
	from alunos a
	inner join cursos c on a.curso_id = c.id
	where c.nome = 'Matemática' or c.nome = 'Física'

-- 19 - Liste alunos que NÃO estão no curso de Administração
select a.nome as aluno, c.nome as curso
	from alunos a
	inner join cursos c on a.curso_id = c.id
	where c.nome <> 'Administração'

-- 20 - Mostre todos os nomes que aparecem em alunos OU professores (sem duplicados)
select nome from alunos
union
select nome from professores

-- 21 - Quais nomes aparecem tanto em alunos quanto em professores?
select nome from alunos
intersect
select nome from professores

-- 22 - Quais nomes estão em alunos mas NÃO em professores?
select nome from alunos
except
select nome from professores
